// SANDBOX ONLY. NEVER APPLY TO lifeplan-private-sync.
// Replace the dummy project-side test user UID in the *separate* Spark test
// Firebase Console. Until then the template rejects every real user.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function testOwner(uid) {
   return request.auth != null &&
      request.auth.uid == uid &&
      uid == '__SET_SANDBOX_TEST_UID_PRIVATELY__';
  }
  function validTestRecord(uid) {
   return request.resource.data.keys().hasOnly([
      'ownerUid','formatVersion','revision','digest','ciphertext','updatedAt'
   ]) &&
   request.resource.data.keys().hasAll([
      'ownerUid','formatVersion','revision','digest','ciphertext','updatedAt'
   ]) &&
   request.resource.data.ownerUid == uid &&
   request.resource.data.formatVersion == 1 &&
   request.resource.data.revision is int &&
   request.resource.data.revision >= 1 &&
   request.resource.data.digest is string &&
   request.resource.data.digest.matches('^[a-f0-9]{64}$') &&
   request.resource.data.ciphertext is map &&
   request.resource.data.ciphertext.keys().hasOnly([
      'version','algorithm','iterations','salt','iv','data'
   ]) &&
   request.resource.data.ciphertext.keys().hasAll([
      'version','algorithm','iterations','salt','iv','data'
   ]) &&
   request.resource.data.ciphertext.version == 1 &&
   request.resource.data.ciphertext.algorithm == 'AES-256-GCM/PBKDF2-SHA256' &&
   request.resource.data.ciphertext.iterations == 600000 &&
   request.resource.data.ciphertext.data is string &&
   request.resource.data.ciphertext.data.size() > 0 &&
   request.resource.data.ciphertext.data.size() <= 725000 &&
   request.resource.data.ciphertext.salt is string &&
   request.resource.data.ciphertext.salt.size() > 0 &&
   request.resource.data.ciphertext.salt.size() <= 128 &&
   request.resource.data.ciphertext.iv is string &&
   request.resource.data.ciphertext.iv.size() > 0 &&
   request.resource.data.ciphertext.iv.size() <= 128 &&
   request.resource.data.updatedAt is timestamp;
  }
  match /sandbox/{uid}/snapshots/{documentId} {
   allow get: if documentId == 'trial' && testOwner(uid);
   allow list: if false;
   allow create: if documentId == 'trial' && testOwner(uid) &&
      validTestRecord(uid) && request.resource.data.revision == 1;
   allow update: if documentId == 'trial' && testOwner(uid) &&
      validTestRecord(uid) && resource.data.ownerUid == uid &&
      request.resource.data.revision == resource.data.revision + 1;
   // Test-only cleanup of the one disposable record after verification.
   allow delete: if documentId == 'trial' && testOwner(uid) &&
      resource.data.ownerUid == uid;
  }
  match /{other=**} { allow read, write: if false; }
 }
}
